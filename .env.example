APP_NAME=AdReady
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Optional first administrator bootstrap. Use a unique secret of at least 20 characters.
# The seeder creates this account only when the email is not already present and never resets existing credentials.
ADREADY_BOOTSTRAP_ADMIN_EMAIL=
ADREADY_BOOTSTRAP_ADMIN_NAME="AdReady Administrator"
ADREADY_BOOTSTRAP_ADMIN_PASSWORD=

# Optional demonstration account, seeded only in local/testing environments.
ADREADY_DEMO_EMAIL=
ADREADY_DEMO_NAME="Demo Publisher"
ADREADY_DEMO_PASSWORD=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=adready
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=adready

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# AI provider (OpenRouter). Every key can also be managed from the admin
# panel at /manage/settings so you never have to redeploy to change a model.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://your-domain.com
OPENROUTER_SITE_NAME="${APP_NAME}"

# Fallback model routing used when the admin panel has not been configured.
ADREADY_MODEL_NORMAL=kimi/kimi-k2-thinking
ADREADY_MODEL_STANDARD=anthropic/claude-sonnet-4.5
ADREADY_MODEL_PREMIUM=anthropic/claude-opus-4.1
ADREADY_IMAGE_MODEL=google/gemini-2.5-flash-image

# Credits consumed per audit run, by mode.
ADREADY_CREDITS_NORMAL=1
ADREADY_CREDITS_STANDARD=3
ADREADY_CREDITS_PREMIUM=6

# Google OAuth (Sign in with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Bing Webmaster / IndexNow / Google Indexing API
INDEXNOW_API_KEY=
BING_WEBMASTER_API_KEY=
GOOGLE_INDEXING_SERVICE_ACCOUNT=

# Currency display
ADREADY_PRIMARY_CURRENCY=USD
ADREADY_BDT_RATE=122.5
ADREADY_CURRENCY_UPDATE_URL=

# Referral programme
ADREADY_REFERRAL_RATE=20
ADREADY_MIN_PAYOUT=10

# Queue / job tuning
ADREADY_AUDIT_QUEUE=default
ADREADY_PDF_DISK=local
ADREADY_PDF_PATH=reports
